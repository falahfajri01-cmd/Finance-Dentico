# ── Dentico Finance · Supabase configuration ─────────────────────────
# Supabase (managed PostgreSQL) is the only backend. The old self-hosted
# PostgreSQL + Drizzle ORM layer has been removed.
#
# 1. Create a free project at https://supabase.com
# 2. In the SQL Editor run the single file:  supabase/install.sql
# 3. Copy your keys (Project Settings → API → anon public key) here:
#
#    cp .env.example .env
#
# The anon key is PUBLIC — it is compiled into the browser bundle that
# you upload to public_html. Never place the service_role key here.
# Without these variables the app runs in demo mode with bundled dummy data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ── Static hosting (cPanel / shared hosting, no Node.js) ─────────────
# Public base path of the deployed site.
#   VITE_BASE_PATH=/            → site at the domain root (public_html)
#   VITE_BASE_PATH=/finance/    → site in a subdirectory (public_html/finance)
VITE_BASE_PATH=/
